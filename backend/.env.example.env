# เทมเพลตของ backend/.env — ก๊อปเป็น .env แล้วเติมค่าจริง (.env ไม่ขึ้น git)

# HTTP port ของ API server (ตอน dev frontend/.env.development ยิงมาที่ port นี้)
PORT=3011

# prefix ที่แอปถูก mount ไว้หลัง Apache
# ⚠️ เปลี่ยนค่านี้ต้องเปลี่ยนพร้อมกันกับ APP_BASE ใน frontend/src/utils/config.js,
#    homepage ใน frontend/package.json และ config ของ Apache (อยู่นอก repo)
APP_BASE=/PROJECT-MANAGEMENT

# MariaDB — DB user / รหัสผ่าน ผู้ดูแลระบบสร้างให้ (ไม่ใช้ root)
# DB_HOST / DB_USER / DB_NAME ขาดไม่ได้ ไม่มีแล้ว server ไม่ยอม start
# ต้องสร้าง database ก่อน:
#   CREATE DATABASE project_management CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# แล้วสร้างตารางด้วย: npm run db:apply
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=project_management
DB_POOL_MAX=10
