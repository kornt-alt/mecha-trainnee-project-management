# เทมเพลตของ frontend/.env — ก๊อปเป็น .env แล้วเติมค่าจริง (.env ไม่ขึ้น git)
# ⚠️ CRA inline ค่า REACT_APP_* ลง bundle ตอน build — ทุกคนที่เปิดเว็บอ่านได้ ห้ามใส่รหัสผ่าน DB

# origin ของ backend · production เว้นว่าง (Apache proxy ให้ใน origin เดียวกัน)
# dev ตั้งไว้ใน .env.development แล้ว
REACT_APP_API_ORIGIN=
